# Liftosaur Settings > API Keys. Requires Liftosaur Premium.
LIFTOSAUR_API_KEY=

# Intervals.icu Settings > Developer Settings > API Key.
INTERVALS_API_KEY=

# Use your real Intervals athlete ID, e.g. i123456. The "i" shortcut does not work with API-key auth.
INTERVALS_ATHLETE_ID=i123456

# Must match the timezone configured for the Intervals athlete.
SYNC_TIMEZONE=America/New_York

# Strava API app credentials. Run `UV_ENV_FILE=.env uv run liftosaur-sync strava-auth` to populate STRAVA_REFRESH_TOKEN.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
